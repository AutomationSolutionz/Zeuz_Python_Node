{
    "manifest_version": 3,
    "name": "ZeuZ Element Inspector",
    "description": "Inspect page elements and use ZeuZ AI-supported plugin to automate testing in minutes.",
    "homepage_url": "https://www.zeuz.ai/",
    "version": "2",
    "icons": {
        "64": "zeuz.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_icon": {
            "16": "zeuz.png",
            "24": "zeuz.png",
            "32": "zeuz.png"
        },
        "default_title": "Ctrl + Shift + X"
    },
    "content_scripts": [
        {
            "all_frames": true,
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "page_map_extractor.js",
                "inspect.js"
            ]
        },
        {
            "all_frames": false, 
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js" 
            ]
        }
    ],
    "commands": {
        "toggle-xpath": {
            "suggested_key": {
                "default": "Ctrl+Shift+X",
                "mac": "Command+Shift+X"
            },
            "description": "Toggle plugin"
        }
    },
    "options_page": "options.html",
    "permissions": [
        "activeTab",
        "contextMenus",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "http://*/",
        "https://*/"
    ],
    "web_accessible_resources": [
    {
        "resources": ["zeuz.png", "zeuz-active.png"],
        "matches": ["<all_urls>"]
    }
]
}